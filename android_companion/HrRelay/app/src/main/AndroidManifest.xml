<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local UDP relay to the Quest on the same Wi-Fi / phone hotspot. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keep relaying with the screen off / app backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Reading Mi Fitness HrItem logs requires READ_LOGS. This is a
      signature|privileged|development permission: it is NOT granted at install
      to a sideloaded app. Grant it ONCE over ADB during setup, then no computer
      is needed at run time:
        adb shell pm grant me.djurovic.hrrelay android.permission.READ_LOGS
      See STANDALONE_HR_SETUP.md and STANDALONE_HR_KNOWN_LIMITATIONS.md.
    -->
    <uses-permission android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_compass"
        android:supportsRtl="true"
        android:theme="@style/Theme.HrRelay">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".HrRelayService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
